# RALLY — environment variables
# Copy to .env and fill in. Never commit .env.

# --- Football data (European schedule source) ---
# football-data.org — free tier, World Cup competition code "WC".
FOOTBALL_DATA_TOKEN=

# API-Football (api-sports.io) — live scores/events/lineups/odds, every 15s.
API_FOOTBALL_KEY=

# --- Supabase (backend) ---
# RALLY project (NOT Patentopia): owxofpjcfymgjgrctnab
# Dashboard: https://supabase.com/dashboard/project/owxofpjcfymgjgrctnab
SUPABASE_URL=https://owxofpjcfymgjgrctnab.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (Vite needs the VITE_ prefix to expose to the client) ---
VITE_SUPABASE_URL=https://owxofpjcfymgjgrctnab.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Content engine (scripts/social-pack.mjs — GENERATE-ONLY) ---
# Captions + video scripts are written to SOUL.md by claude-opus-4-8.
# If ANTHROPIC_API_KEY is ABSENT the pack still builds, degrading to a
# deterministic SOUL-flavoured template — so a dry/missing key never breaks
# the daily pack.
ANTHROPIC_API_KEY=
# Higgsfield image→video (generate_video: grok_video_v15 / kling3_0) for the
# 9:16 motion shot. OPTIONAL — when absent, the engine uses the deterministic
# ffmpeg Ken-Burns fallback (zero external keys, budget-safe).
HIGGSFIELD_API_KEY=

# --- Optional ---
ELEVENLABS_API_KEY=
