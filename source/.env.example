# RALLY — environment variables
# Copy to .env and fill in. Never commit .env.

# --- Football data (European; replaces ESPN) ---
# football-data.org — free tier, World Cup competition code "WC".
FOOTBALL_DATA_TOKEN=

# API-Football (api-sports.io) — live scores/events/lineups/odds, every 15s.
API_FOOTBALL_KEY=

# --- Supabase (backend) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (Vite needs the VITE_ prefix to expose to the client) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional ---
ELEVENLABS_API_KEY=
